{
  "functions": {
    "app/api/competitors/scrape/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/daily-scrape/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/finance-snapshot/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/generate-recurring-income/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-scrape",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/finance-snapshot",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/generate-recurring-income",
